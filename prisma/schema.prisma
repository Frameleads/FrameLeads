generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model InboundSignal {
  id              String         @id @default(uuid())
  userId          String?
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  generatedLeadId String?
  generatedLead   GeneratedLead? @relation(fields: [generatedLeadId], references: [id], onDelete: Cascade)
  sourceMessageId String?
  prospectName    String
  prospectContext String
  prospectEmail   String?
  pipelineValue   Int            @default(5000)
  dealStage       String
  rawEmail        String
  intentRisk      String
  signals         String[]       @default([])
  intentType      String
  intentScore     Int            @default(0)
  confidenceScore Int            @default(0)
  signalAnalysis  String?
  aiDraft         String
  status          String         @default("PENDING")
  createdAt       DateTime       @default(now())

  // ── Phase 4: Signal Ingestion Metadata ─────────────────────────
  // These fields distinguish signal-triggered entries from manual
  // triage entries so the UI can priority-sort the queue.
  isHighPriority Boolean @default(false)
  sourceType     String  @default("MANUAL")
  signalType     String?

  // ── Phase 5: Governance Analytics ──────────────────────────────
  // Timestamp of when a human approved/rejected this signal.
  // Used to calculate Time-to-Approval metrics.
  approvedAt DateTime?

  @@unique([userId, sourceMessageId])
  @@index([userId, status, isHighPriority])
  @@index([createdAt])
  @@index([generatedLeadId])
}

// ── Phase 5: Institutional Memory ────────────────────────────────────
// Custom objection-handling rules and negative CTAs saved by the user.
// Each rule represents a reusable playbook entry that the AI references
// during triage draft generation. The count of these rules is the
// "Institutional Memory Score" — a measure of how much tribal knowledge
// has been codified into the system.

model GovernanceRule {
  id        String   @id @default(cuid())
  userId    String
  ruleType  String   @default("objection_override")
  trigger   String
  response  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isActive])
}

// ── Phase 4: API Key Authentication ──────────────────────────────────
// Each user gets one or more API keys for authenticating webhook
// requests from external tools (Clay, Phantombuster, custom scrapers).
// Keys are hashed at rest; the raw key is shown only once at creation.

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  keyHash    String    @unique
  label      String    @default("Default")
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([keyHash])
  @@index([userId])
}

model User {
  id             String   @id @default(cuid())
  whopId         String   @unique
  email          String   @unique
  tier           String   @default("INACTIVE")
  monthlyQuota   Int      @default(0)
  leadsProcessed Int      @default(0)
  imapEmail      String?
  imapPassword   String?  @db.Text
  imapHost       String?
  imapPort       Int?     @default(993)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // ── Phase 3: Deployment Armor ──────────────────────────────────
  // A user's root brand domain (e.g., "company.com") is stored here
  // so the Domain Armor validator can block outbound from root domains.
  rootBrandDomain String?

  inboxes        SendingInbox[]
  inboundSignals InboundSignal[]
}

// ── Phase 3: Sending Infrastructure ──────────────────────────────────
// Each connected sending inbox tracks its email address, daily send
// volume, and governance status. The OutboundLog records every
// individual email dispatched for rate-limit enforcement.

model SendingInbox {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  emailAddress String
  displayName  String?
  status       String   @default("active")
  createdAt    DateTime @default(now())

  outboundLogs OutboundLog[]

  @@index([userId])
  @@index([emailAddress])
}

model OutboundLog {
  id      String        @id @default(cuid())
  inboxId String
  inbox   SendingInbox  @relation(fields: [inboxId], references: [id])
  leadId  String
  lead    GeneratedLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel String        @default("email")
  status  String        @default("sent")
  sentAt  DateTime      @default(now())

  @@index([inboxId, sentAt])
  @@index([leadId])
}

model GeneratedLead {
  id              String          @id @default(cuid())
  userId          String // This links the lead to the specific logged-in Whop user
  firstName       String
  lastName        String
  linkedInUrl     String?
  companyName     String
  websiteUrl      String?
  email           String?
  score           Int?
  targetGroup     String?
  incidentDetails String?
  emailDraft      String          @db.Text
  linkedInDraft   String          @db.Text
  coldCallDraft   String?         @db.Text
  whatsAppDraft   String?         @db.Text
  listId          String?
  list            LeadList?       @relation(fields: [listId], references: [id], onDelete: SetNull)
  outboundLogs    OutboundLog[]
  inboundSignals  InboundSignal[]
  createdAt       DateTime        @default(now())

  @@index([userId, linkedInUrl])
  @@index([listId])
}

model LeadList {
  id        String          @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  leads     GeneratedLead[]

  @@index([userId])
}
