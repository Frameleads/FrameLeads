generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model InboundSignal {
  id              String         @id @default(uuid())
  prospectId      String?
  prospect        Prospect?      @relation(fields: [userId, prospectId], references: [userId, id], onDelete: NoAction, onUpdate: NoAction)
  userId          String?
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  generatedLeadId String?
  generatedLead   GeneratedLead? @relation(fields: [generatedLeadId], references: [id], onDelete: Cascade)
  sourceMessageId String?
  prospectName    String
  prospectContext String
  prospectEmail   String?
  pipelineValue   Int            @default(5000)
  dealStage       String
  rawEmail        String
  intentRisk      String
  signals         String[]       @default([])
  intentType      String
  intentScore     Int            @default(0)
  confidenceScore Int            @default(0)
  signalAnalysis  String?
  aiDraft         String
  status          String         @default("PENDING")
  createdAt       DateTime       @default(now())

  // ── Phase 4: Signal Ingestion Metadata ─────────────────────────
  // These fields distinguish signal-triggered entries from manual
  // triage entries so the UI can priority-sort the queue.
  isHighPriority Boolean @default(false)
  sourceType     String  @default("MANUAL")
  signalType     String?

  // ── Phase 5: Governance Analytics ──────────────────────────────
  // Timestamp of when a human approved/rejected this signal.
  // Used to calculate Time-to-Approval metrics.
  approvedAt DateTime?

  @@unique([userId, sourceMessageId])
  @@index([userId, status, isHighPriority])
  @@index([createdAt])
  @@index([generatedLeadId])
  @@index([userId, prospectId])
}

// ── Phase 5: Institutional Memory ────────────────────────────────────
// Custom objection-handling rules and negative CTAs saved by the user.
// Each rule represents a reusable playbook entry that the AI references
// during triage draft generation. The count of these rules is the
// "Institutional Memory Score" — a measure of how much tribal knowledge
// has been codified into the system.

model GovernanceRule {
  id        String   @id @default(cuid())
  userId    String
  ruleType  String   @default("objection_override")
  trigger   String
  response  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isActive])
}

// ── Phase 4: API Key Authentication ──────────────────────────────────
// Each user gets one or more API keys for authenticating webhook
// requests from external tools (Clay, Phantombuster, custom scrapers).
// Keys are hashed at rest; the raw key is shown only once at creation.

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  keyHash    String    @unique
  label      String    @default("Default")
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([keyHash])
  @@index([userId])
}

model User {
  id             String   @id @default(cuid())
  whopId         String   @unique
  email          String   @unique
  tier           String   @default("INACTIVE")
  monthlyQuota   Int      @default(0)
  leadsProcessed Int      @default(0)
  imapEmail      String?
  imapPassword   String?  @db.Text
  imapHost       String?
  imapPort       Int?     @default(993)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // ── Phase 3: Deployment Armor ──────────────────────────────────
  // A user's root brand domain (e.g., "company.com") is stored here
  // so the Domain Armor validator can block outbound from root domains.
  rootBrandDomain String?

  inboxes                SendingInbox[]
  inboundSignals         InboundSignal[]
  prospects              Prospect[]
  icpProfile             ICPProfile?
  qualifications         ProspectQualification[]
  aiUsageEvents          AIUsageEvent[]
  companies              Company[]
  memoryStates           ProspectMemoryState[]
  memoryEvents           ProspectMemoryEvent[]
  brain                  FrameLeadsBrain?
  brainEntries           BrainKnowledgeEntry[]
  revenuePlaybook        RevenuePlaybook?
  revenuePlaybookRules   RevenuePlaybookRule[]
  salesConstitution      SalesConstitution?
  salesConstitutionRules SalesConstitutionRule[]
  constitutionEvents     SalesConstitutionRevisionEvent[]
  conversations          Conversation[]
  conversationMessages   ConversationMessage[]
  decisions              Decision[]
  decisionTraces         DecisionTrace[]
  automationPolicy       AutomationPolicy?
  automationOverrides    AutomationCampaignOverride[]
  prospectHolds          ProspectHold[]
  automationResolutions  DecisionAutomationResolution[]
  decisionActions        DecisionActionEvent[]
  decisionAssignments    DecisionAssignment[]
  decisionExecutions     DecisionExecutionAttempt[]
  revenueRiskAssessments DecisionRevenueRisk[]
}

// ── Phase 3: Sending Infrastructure ──────────────────────────────────
// Each connected sending inbox tracks its email address, daily send
// volume, and governance status. The OutboundLog records every
// individual email dispatched for rate-limit enforcement.

model SendingInbox {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  emailAddress String
  displayName  String?
  status       String   @default("active")
  createdAt    DateTime @default(now())

  outboundLogs OutboundLog[]

  @@index([userId])
  @@index([emailAddress])
}

model OutboundLog {
  id      String        @id @default(cuid())
  inboxId String
  inbox   SendingInbox  @relation(fields: [inboxId], references: [id])
  leadId  String
  lead    GeneratedLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel String        @default("email")
  status  String        @default("sent")
  sentAt  DateTime      @default(now())

  @@index([inboxId, sentAt])
  @@index([leadId])
}

model GeneratedLead {
  id              String          @id @default(cuid())
  prospectId      String?
  prospect        Prospect?       @relation(fields: [userId, prospectId], references: [userId, id], onDelete: NoAction, onUpdate: NoAction)
  userId          String // This links the lead to the specific logged-in Whop user
  firstName       String
  lastName        String
  linkedInUrl     String?
  companyName     String
  websiteUrl      String?
  email           String?
  score           Int?
  targetGroup     String?
  incidentDetails String?
  emailDraft      String          @db.Text
  linkedInDraft   String          @db.Text
  coldCallDraft   String?         @db.Text
  whatsAppDraft   String?         @db.Text
  listId          String?
  list            LeadList?       @relation(fields: [listId], references: [id], onDelete: SetNull)
  outboundLogs    OutboundLog[]
  inboundSignals  InboundSignal[]
  createdAt       DateTime        @default(now())

  @@index([userId, linkedInUrl])
  @@index([listId])
  @@index([userId, prospectId])
}

model Prospect {
  id                    String                 @id @default(cuid())
  userId                String
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  firstName             String?
  lastName              String?
  email                 String?
  normalizedEmail       String?
  linkedInUrl           String?
  normalizedLinkedInUrl String?
  companyName           String?
  websiteUrl            String?
  jobTitle              String?
  industry              String?
  country               String?
  location              String?
  companySizeMin        Int?
  companySizeMax        Int?
  fallbackIdentityKey   String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  generatedLeads        GeneratedLead[]
  inboundSignals        InboundSignal[]
  intelligence          ProspectIntelligence?
  qualification         ProspectQualification?
  aiUsageEvents         AIUsageEvent[]
  companyId             String?
  company               Company?               @relation(fields: [userId, companyId], references: [userId, id], onDelete: NoAction, onUpdate: NoAction)
  memoryState           ProspectMemoryState?
  memoryEvents          ProspectMemoryEvent[]
  conversation          Conversation?
  conversationMessages  ConversationMessage[]
  decisions             Decision[]
  automationHold        ProspectHold?

  @@unique([userId, id])
  @@unique([userId, normalizedEmail])
  @@unique([userId, normalizedLinkedInUrl])
  @@index([userId, fallbackIdentityKey])
  @@index([userId, companyId])
}

model ProspectMemoryState {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  prospectId     String
  prospect       Prospect  @relation(fields: [userId, prospectId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction)
  rollingSummary String    @default("") @db.Text
  eventCount     Int       @default(0)
  lastEventAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, prospectId])
  @@index([userId, lastEventAt])
}

model ProspectMemoryEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prospectId  String
  prospect    Prospect @relation(fields: [userId, prospectId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction)
  eventType   String
  sourceType  String
  sourceId    String
  description String   @db.Text
  importance  Int      @default(1)
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([userId, prospectId, sourceType, sourceId, eventType], map: "ProspectMemoryEvent_source_key")
  @@index([userId, prospectId, occurredAt])
  @@index([userId, prospectId, eventType, occurredAt])
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum ConversationDirection {
  INBOUND
  OUTBOUND
}

enum ConversationSourceType {
  INBOUND_SIGNAL
  OUTBOUND_LOG
}

model Conversation {
  id            String                @id @default(cuid())
  userId        String
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  prospectId    String
  prospect      Prospect              @relation(fields: [userId, prospectId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction)
  status        ConversationStatus    @default(OPEN)
  lastMessageAt DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  messages      ConversationMessage[]
  decisions     Decision[]

  @@unique([userId, id])
  @@unique([userId, prospectId])
  @@index([userId, lastMessageAt])
}

model ConversationMessage {
  id             String                 @id @default(cuid())
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation           @relation(fields: [userId, conversationId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction)
  prospectId     String
  prospect       Prospect               @relation(fields: [userId, prospectId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction)
  direction      ConversationDirection
  sourceType     ConversationSourceType
  sourceId       String
  providerId     String?
  body           String?                @db.Text
  occurredAt     DateTime
  createdAt      DateTime               @default(now())
  decisions      Decision[]

  @@unique([userId, id])
  @@unique([userId, sourceType, sourceId], map: "ConversationMessage_source_key")
  @@index([userId, conversationId, occurredAt])
}

enum DecisionType {
  INBOUND_TRIAGE
}

enum DecisionStatus {
  PENDING
  READY
  NEEDS_REVIEW
  FAILED
}

enum DecisionSource {
  DETERMINISTIC
  GEMINI
  UNAVAILABLE
}

enum TriageIntent {
  POSITIVE_INTEREST
  MEETING_REQUEST
  PRICING_INQUIRY
  PRICING_OBJECTION
  TIMING_OBJECTION
  COMPETITOR_OBJECTION
  TRUST_OBJECTION
  BUDGET_OBJECTION
  FEATURE_QUESTION
  FEATURE_GAP
  INTEGRATION_QUESTION
  SECURITY
  PROCUREMENT
  LEGAL
  COMPLIANCE
  REFERRAL
  WRONG_PERSON
  NOT_INTERESTED
  UNSUBSCRIBE
  OUT_OF_OFFICE
  NEUTRAL_QUESTION
  CONFUSED
  NEGOTIATION
  EXISTING_CUSTOMER
  SPAM
  OTHER
}

model Decision {
  id                    String                         @id @default(cuid())
  userId                String
  user                  User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  prospectId            String
  prospect              Prospect                       @relation(fields: [userId, prospectId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction)
  conversationId        String
  conversation          Conversation                   @relation(fields: [userId, conversationId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction)
  inputMessageId        String
  inputMessage          ConversationMessage            @relation(fields: [userId, inputMessageId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction)
  decisionType          DecisionType                   @default(INBOUND_TRIAGE)
  status                DecisionStatus                 @default(PENDING)
  source                DecisionSource                 @default(UNAVAILABLE)
  contextFingerprint    String
  primaryIntent         TriageIntent?
  secondaryIntents      TriageIntent[]                 @default([])
  intentSignals         Json?
  confidenceScore       Int?
  interpretation        String?                        @db.Text
  recommendedNextAction String?                        @db.Text
  suggestedReply        String?                        @db.Text
  requiresReview        Boolean                        @default(true)
  reviewReasons         String[]                       @default([])
  explanation           String?                        @db.Text
  provider              AIProvider?
  model                 String?
  shadowMode            Boolean                        @default(true)
  supersedesDecisionId  String?
  automationMode        String?
  assignedOwnerId       String?
  revenueAtRiskScore    Int?
  slaDueAt              DateTime?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  trace                 DecisionTrace?
  automationResolutions DecisionAutomationResolution[]
  actionEvents          DecisionActionEvent[]
  assignment            DecisionAssignment?
  executionAttempt      DecisionExecutionAttempt?
  revenueRisk           DecisionRevenueRisk?

  @@unique([userId, id])
  @@unique([userId, inputMessageId, decisionType, contextFingerprint], map: "Decision_context_key")
  @@index([userId, prospectId, createdAt])
  @@index([userId, inputMessageId])
  @@index([userId, status, createdAt])
}

model DecisionTrace {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  decisionId           String   @unique
  decision             Decision @relation(fields: [userId, decisionId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction)
  inputMessageId       String
  contextFingerprint   String
  memoryState          Json?
  icpState             Json?
  brainRevision        Int?
  playbookRevision     Int?
  constitutionRevision Int?
  intentOutput         Json?
  policyResult         Json?
  playbookRuleIds      String[] @default([])
  brainEntryIds        String[] @default([])
  contextReferences    Json?
  engineVersion        String
  explanation          String   @db.Text
  createdAt            DateTime @default(now())

  @@unique([userId, decisionId])
}

enum RevenueRiskBand {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RevenueRiskConfidence {
  LOW
  MEDIUM
  HIGH
}

enum RevenueRiskStatus {
  APPLICABLE
  INSUFFICIENT_DATA
  NOT_APPLICABLE
}

model DecisionRevenueRisk {
  id               String                @id @default(cuid())
  userId           String
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  decisionId       String
  decision         Decision              @relation(fields: [userId, decisionId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction)
  status           RevenueRiskStatus
  score            Int?
  band             RevenueRiskBand?
  confidence       RevenueRiskConfidence
  components       Json
  reasons          String[]              @default([])
  sourceReferences Json
  scoringVersion   String
  inputFingerprint String
  evaluatedAt      DateTime              @default(now())
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([userId, decisionId])
  @@index([userId, status, score])
}

enum BrainKnowledgeCategory {
  COMPANY
  PRODUCT
  OFFER
  ICP
  POSITIONING
  DIFFERENTIATOR
  PAIN_POINT
  VALUE_PROPOSITION
  PROOF
  CASE_STUDY
  PRICING
  COMMERCIAL_TERM
  INTEGRATION
  OBJECTION_CONTEXT
  TONE
  CTA
  SALES_PROCESS
  FAQ
  LIMITATION
  MARKET
  OTHER
}

enum BrainKnowledgeSource {
  USER_ENTERED
  USER_PROFILE
  ICP_PROFILE
}

enum BrainVerification {
  VERIFIED
  UNVERIFIED
  INFERRED
  CONFLICTED
}

model FrameLeadsBrain {
  id                    String                @id @default(cuid())
  userId                String                @unique
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  revision              Int                   @default(0)
  compactSummary        String                @default("") @db.Text
  lastKnowledgeUpdateAt DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  entries               BrainKnowledgeEntry[]

  @@unique([userId, id])
}

model BrainKnowledgeEntry {
  id           String                 @id @default(cuid())
  userId       String
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  brainId      String
  brain        FrameLeadsBrain        @relation(fields: [userId, brainId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction)
  category     BrainKnowledgeCategory
  key          String
  value        String                 @db.Text
  sourceType   BrainKnowledgeSource
  sourceKey    String
  sourceId     String?
  verification BrainVerification      @default(UNVERIFIED)
  importance   Int                    @default(1)
  revision     Int                    @default(1)
  archivedAt   DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([userId, sourceType, sourceKey])
  @@index([userId, category, verification, archivedAt])
  @@index([userId, brainId, archivedAt])
}

enum RevenueScenario {
  GENERAL
  PRICING
  DISCOUNT
  BUDGET
  INTEGRATION
  SECURITY
  LEGAL
  COMPLIANCE
  PROCUREMENT
  TIMING
  NOT_NOW
  FEATURE
  FEATURE_GAP
  IMPLEMENTATION
  ONBOARDING
  PROOF
  CASE_STUDY
  COMPETITOR
  AUTHORITY
  STAKEHOLDER
  MEETING
  DEMO
  TRIAL
  PILOT
  POSITIVE_INTENT
  OBJECTION
  SILENCE_FOLLOWUP
  NEGATIVE_REPLY
  UNSUBSCRIBE
  CUSTOM
}

enum RevenuePlaybookSource {
  USER_ENTERED
  SYSTEM_DEFAULT
}

enum RevenueDirection {
  INBOUND
  OUTBOUND
}

model RevenuePlaybook {
  id        String                @id @default(cuid())
  userId    String                @unique
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String                @default("Default Revenue Playbook")
  revision  Int                   @default(0)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  rules     RevenuePlaybookRule[]

  @@unique([userId, id])
}

model RevenuePlaybookRule {
  id                     String                       @id @default(cuid())
  userId                 String
  user                   User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  playbookId             String
  playbook               RevenuePlaybook              @relation(fields: [userId, playbookId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction)
  name                   String
  scenario               RevenueScenario
  customScenario         String?
  objective              String                       @db.Text
  guidance               String                       @db.Text
  nextAction             String                       @db.Text
  responsePrinciples     String[]                     @default([])
  ctaGuidance            String?                      @db.Text
  qualificationCondition ProspectQualificationStatus?
  direction              RevenueDirection?
  priority               Int                          @default(1)
  enabled                Boolean                      @default(true)
  source                 RevenuePlaybookSource        @default(USER_ENTERED)
  sourceKey              String?
  revision               Int                          @default(1)
  archivedAt             DateTime?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt

  @@unique([userId, source, sourceKey])
  @@index([userId, scenario, enabled, archivedAt, priority], map: "RevenuePlaybookRule_lookup_idx")
  @@index([userId, playbookId, archivedAt])
}

enum ConstitutionCategory {
  CLAIM
  PRICING
  DISCOUNT
  COMMERCIAL_TERM
  LEGAL
  COMPLIANCE
  SECURITY
  PRIVACY
  DATA_HANDLING
  CONTRACT
  CAPABILITY
  COMPETITOR
  OUTREACH
  UNSUBSCRIBE
  COMMUNICATION
  COMMITMENT
  APPROVAL
  CUSTOM
}

enum ConstitutionEffect {
  BLOCK
  REQUIRE_HUMAN
  REQUIRE_APPROVAL
  REQUIRE_SAFE_RESPONSE
}

enum ConstitutionActionType {
  OUTREACH
  DISCOUNT
  CONTRACT
  CLAIM
  TOPIC_RESPONSE
  COMMITMENT
}

enum ConstitutionSource {
  USER_ENTERED
  SYSTEM_DEFAULT
}

enum ConstitutionSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ConstitutionScope {
  GLOBAL
  OUTBOUND
  REPLY_DECISION
  PRICING
  COMMERCIAL
  LEGAL
  COMPLIANCE
  SECURITY
}

enum ConstitutionChangeType {
  CREATE
  EDIT
  ENABLE
  DISABLE
  ARCHIVE
}

model SalesConstitution {
  id        String                           @id @default(cuid())
  userId    String                           @unique
  user      User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String                           @default("Company Sales Constitution")
  revision  Int                              @default(0)
  createdAt DateTime                         @default(now())
  updatedAt DateTime                         @updatedAt
  rules     SalesConstitutionRule[]
  events    SalesConstitutionRevisionEvent[]

  @@unique([userId, id])
}

model SalesConstitutionRule {
  id             String                   @id @default(cuid())
  userId         String
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  constitutionId String
  constitution   SalesConstitution        @relation(fields: [userId, constitutionId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction)
  name           String
  category       ConstitutionCategory
  effect         ConstitutionEffect
  severity       ConstitutionSeverity     @default(MEDIUM)
  scope          ConstitutionScope        @default(GLOBAL)
  description    String                   @db.Text
  constraint     Json
  actionTypes    ConstitutionActionType[] @default([])
  priority       Int                      @default(1)
  enabled        Boolean                  @default(true)
  source         ConstitutionSource       @default(USER_ENTERED)
  sourceKey      String?
  revision       Int                      @default(1)
  archivedAt     DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([userId, source, sourceKey])
  @@index([userId, category, enabled, archivedAt, effect], map: "SalesConstitutionRule_lookup_idx")
  @@index([userId, constitutionId, archivedAt], map: "SalesConstitutionRule_owner_idx")
}

model SalesConstitutionRevisionEvent {
  id                   String                 @id @default(cuid())
  userId               String
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  constitutionId       String
  constitution         SalesConstitution      @relation(fields: [userId, constitutionId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction)
  constitutionRevision Int
  ruleId               String
  changeType           ConstitutionChangeType
  actorId              String
  beforeState          Json?
  afterState           Json?
  createdAt            DateTime               @default(now())

  @@index([userId, constitutionId, createdAt], map: "SalesConstitutionEvent_history_idx")
}

model Company {
  id               String               @id @default(cuid())
  userId           String
  user             User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  name             String?
  normalizedName   String?
  websiteUrl       String?
  normalizedDomain String?
  industry         String?
  companySizeMin   Int?
  companySizeMax   Int?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  prospects        Prospect[]
  intelligence     CompanyIntelligence?
  evidence         CompanyEvidence[]

  @@unique([userId, id])
  @@unique([userId, normalizedDomain])
  @@index([userId, normalizedName])
}

enum CompanyResearchStatus {
  NOT_RESEARCHED
  RESEARCHING
  READY
  NEEDS_REVIEW
  FAILED
}

model CompanyIntelligence {
  id               String                @id @default(cuid())
  userId           String
  companyId        String                @unique
  company          Company               @relation(fields: [userId, companyId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction)
  icpProfileId     String?
  icpProfile       ICPProfile?           @relation(fields: [userId, icpProfileId], references: [userId, id], onDelete: NoAction, onUpdate: NoAction)
  icpFingerprint   String?
  inputFingerprint String?
  status           CompanyResearchStatus @default(NOT_RESEARCHED)
  fitScore         Int?
  fitTier          ProspectFitTier?
  valueBand        ProspectValueBand?
  whyCompanyFits   String?               @db.Text
  whyCompanyNow    String?               @db.Text
  triggers         String[]              @default([])
  risks            String[]              @default([])
  confidenceScore  Int?
  researchedAt     DateTime?
  provider         AIProvider?
  model            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([userId, companyId])
  @@index([userId, status])
  @@index([userId, icpProfileId])
}

model CompanyEvidence {
  id           String               @id @default(cuid())
  userId       String
  companyId    String
  company      Company              @relation(fields: [userId, companyId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction)
  evidenceType ProspectEvidenceType
  sourceTitle  String
  sourceUrl    String?              @db.Text
  claim        String               @db.Text
  capturedAt   DateTime             @default(now())
  createdAt    DateTime             @default(now())

  @@index([userId, companyId])
}

enum AIFeature {
  SCOUT_RESEARCH
  OUTBOUND_GENERATION
  INBOX_TRIAGE
  REPLY_DRAFT
  DECISION_INTELLIGENCE
}

enum AIOperation {
  ICP_ANALYSIS
  SCOUT_COMPANY_ANALYSIS
  SCOUT_PROSPECT_DELTA
  DRAFT_GENERATION
  TRIAGE_ANALYSIS
}

enum AIProvider {
  GEMINI
  ANTHROPIC
}

enum AIUsageStatus {
  SUCCESS
  FAILED
}

model AIUsageEvent {
  id                     String        @id @default(cuid())
  userId                 String
  user                   User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  prospectId             String?
  prospect               Prospect?     @relation(fields: [userId, prospectId], references: [userId, id], onDelete: NoAction, onUpdate: NoAction)
  feature                AIFeature
  operation              AIOperation
  provider               AIProvider
  model                  String
  inputTokens            Int?
  outputTokens           Int?
  totalTokens            Int?
  cachedInputTokens      Int?
  reasoningTokens        Int?
  requestId              String?
  attempt                Int           @default(1)
  companyKey             String?
  status                 AIUsageStatus
  latencyMs              Int
  estimatedCostUsdMicros BigInt?
  createdAt              DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([userId, feature, createdAt])
  @@index([userId, model, createdAt])
  @@index([userId, requestId])
  @@index([userId, prospectId])
}

enum ProspectFitTier {
  STRONG
  MODERATE
  WEAK
  DISQUALIFIED
}

enum ProspectValueBand {
  LOW
  MEDIUM
  HIGH
  STRATEGIC
}

enum ProspectResearchStatus {
  NOT_RESEARCHED
  RESEARCHING
  READY
  NEEDS_REVIEW
  FAILED
}

enum ProspectEvidenceType {
  WEBSITE
  CAREERS
  SOCIAL
  NEWS
  USER_PROVIDED
  INTERNAL
  OTHER
}

enum ProspectIntelligenceEditor {
  SYSTEM
  USER
}

model ProspectIntelligence {
  id                     String                     @id @default(cuid())
  userId                 String
  prospectId             String                     @unique
  prospect               Prospect                   @relation(fields: [userId, prospectId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction)
  fitScore               Int?
  fitTier                ProspectFitTier?
  potentialValueBand     ProspectValueBand?
  estimatedValueAmount   Decimal?                   @db.Decimal(18, 2)
  estimatedValueCurrency String?                    @db.VarChar(3)
  whyFit                 String?                    @db.Text
  whyNow                 String?                    @db.Text
  triggers               String[]                   @default([])
  risks                  String[]                   @default([])
  confidenceScore        Int?
  researchStatus         ProspectResearchStatus     @default(NOT_RESEARCHED)
  lastEditedBy           ProspectIntelligenceEditor @default(SYSTEM)
  researchedAt           DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  evidence               ProspectEvidence[]

  @@unique([userId, id])
  @@unique([userId, prospectId])
  @@index([userId, researchStatus, fitTier])
  @@index([userId, potentialValueBand])
}

model ProspectEvidence {
  id                     String               @id @default(cuid())
  userId                 String
  prospectIntelligenceId String
  prospectIntelligence   ProspectIntelligence @relation(fields: [userId, prospectIntelligenceId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction)
  evidenceType           ProspectEvidenceType
  sourceTitle            String
  sourceUrl              String?              @db.Text
  claim                  String               @db.Text
  confidenceScore        Int?
  isUserProvided         Boolean              @default(false)
  capturedAt             DateTime             @default(now())
  createdAt              DateTime             @default(now())

  @@index([userId, prospectIntelligenceId])
}

enum ProspectQualificationStatus {
  UNASSESSED
  QUALIFIED
  REJECTED
  NEEDS_REVIEW
}

enum ICPQualificationPolicy {
  CONSERVATIVE
  BALANCED
  STRICT
}

enum LeadSourceType {
  UNKNOWN
  USER_CURATED
  BROAD_POOL
  FRAMELEADS_QUALIFIED
}

enum QualificationReasonCode {
  NONE
  EXCLUDED
  TARGET_MISMATCH
  MISSING_DATA
  AMBIGUOUS
  NO_RULES
  INACTIVE
  USER_OVERRIDE
}

enum QualificationOverride {
  AUTO
  USER_QUALIFIED
  USER_EXCLUDED
}

model ICPProfile {
  id                   String                  @id @default(cuid())
  userId               String                  @unique
  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String                  @default("Default ICP")
  isActive             Boolean                 @default(true)
  qualificationPolicy  ICPQualificationPolicy  @default(CONSERVATIVE)
  targetTitles         String[]                @default([])
  targetSeniorities    String[]                @default([])
  targetIndustries     String[]                @default([])
  targetGeographies    String[]                @default([])
  excludedTitles       String[]                @default([])
  excludedIndustries   String[]                @default([])
  excludedDomains      String[]                @default([])
  companySizeMin       Int?
  companySizeMax       Int?
  requiredKeywords     String[]                @default([])
  excludedKeywords     String[]                @default([])
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  qualifications       ProspectQualification[]
  companyIntelligences CompanyIntelligence[]

  @@unique([userId, id])
}

model ProspectQualification {
  id                  String                      @id @default(cuid())
  userId              String
  prospectId          String                      @unique
  prospect            Prospect                    @relation(fields: [userId, prospectId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction)
  icpProfileId        String
  icpProfile          ICPProfile                  @relation(fields: [userId, icpProfileId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction)
  status              ProspectQualificationStatus @default(UNASSESSED)
  reasonCode          QualificationReasonCode     @default(NONE)
  policyVersion       Int                         @default(0)
  override            QualificationOverride       @default(AUTO)
  overriddenAt        DateTime?
  matchedCriteria     String[]                    @default([])
  failedCriteria      String[]                    @default([])
  missingCriteria     String[]                    @default([])
  qualificationReason String                      @db.Text
  profileUpdatedAt    DateTime
  evaluatedAt         DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  User                User                        @relation(fields: [userId], references: [id])

  @@unique([userId, prospectId])
  @@index([userId, status])
  @@index([userId, icpProfileId])
}

model LeadList {
  id                 String                      @id @default(cuid())
  name               String
  userId             String
  sourceType         LeadSourceType              @default(UNKNOWN)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  leads              GeneratedLead[]
  automationOverride AutomationCampaignOverride?

  @@unique([userId, id])
  @@index([userId])
}

enum AutomationMode {
  AUTOPILOT
  HUMAN_APPROVAL
  MANDATORY_ESCALATION
}

enum CampaignAutomationMode {
  INHERIT
  AUTOPILOT
  HUMAN_APPROVAL
  MANDATORY_ESCALATION
  DISABLE_AUTOMATION
}

enum AutomationExecutionState {
  READY
  PENDING_APPROVAL
  ESCALATED
  HELD
  BLOCKED
  REANALYSIS_REQUIRED
  EXECUTING
  EXECUTED
  REJECTED
  FAILED_UNCERTAIN
}

enum DecisionHumanAction {
  APPROVE
  EDIT_AND_SEND
  REJECT
  ESCALATE
  AUTOPILOT_SEND
}

enum DecisionAssignmentStatus {
  OPEN
  RESOLVED
}

enum DecisionRouteQueue {
  ACCOUNT_OWNER
  SALES
  MANAGER
  SALES_ENGINEERING
  LEGAL
  HUMAN_REVIEW
}

enum DecisionExecutionStatus {
  CLAIMED
  SENT
  FAILED_UNCERTAIN
}

model AutomationPolicy {
  id                     String         @id @default(cuid())
  userId                 String         @unique
  user                   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultMode            AutomationMode @default(HUMAN_APPROVAL)
  fallbackMode           AutomationMode @default(HUMAN_APPROVAL)
  autopilotEnabled       Boolean        @default(false)
  autoExecutionDisabled  Boolean        @default(true)
  autopilotMinConfidence Int            @default(90)
  maxAutoSendsPerDay     Int            @default(20)
  revision               Int            @default(1)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
}

model AutomationCampaignOverride {
  id         String                 @id @default(cuid())
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadListId String
  leadList   LeadList               @relation(fields: [userId, leadListId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction)
  mode       CampaignAutomationMode @default(INHERIT)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@unique([userId, leadListId])
}

model ProspectHold {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  prospectId       String
  prospect         Prospect  @relation(fields: [userId, prospectId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction)
  active           Boolean   @default(true)
  reason           String    @db.Text
  releasedAt       DateTime?
  releasedByUserId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, prospectId])
}

model DecisionAutomationResolution {
  id                           String                   @id @default(cuid())
  userId                       String
  user                         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  decisionId                   String
  decision                     Decision                 @relation(fields: [userId, decisionId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction)
  requestedMode                AutomationMode
  resolvedMode                 AutomationMode
  state                        AutomationExecutionState
  reasons                      String[]                 @default([])
  confidence                   Int?
  policyRevision               Int
  decisionConstitutionRevision Int?
  currentConstitutionRevision  Int?
  campaignOverrideId           String?
  prospectHoldId               String?
  constitutionRuleIds          String[]                 @default([])
  createdAt                    DateTime                 @default(now())

  @@index([userId, decisionId, createdAt])
}

model DecisionAssignment {
  id         String                   @id @default(cuid())
  userId     String
  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  decisionId String
  decision   Decision                 @relation(fields: [userId, decisionId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction)
  status     DecisionAssignmentStatus @default(OPEN)
  queue      DecisionRouteQueue       @default(HUMAN_REVIEW)
  reason     String                   @db.Text
  assignedAt DateTime                 @default(now())
  resolvedAt DateTime?

  @@unique([userId, decisionId])
  @@index([userId, status, assignedAt])
}

model DecisionExecutionAttempt {
  id                            String                  @id @default(cuid())
  userId                        String
  user                          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  decisionId                    String
  decision                      Decision                @relation(fields: [userId, decisionId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction)
  idempotencyKey                String                  @unique
  status                        DecisionExecutionStatus @default(CLAIMED)
  mode                          AutomationMode
  actorUserId                   String?
  contentFingerprint            String
  sentContent                   String                  @db.Text
  provider                      String
  providerMessageId             String?
  decisionConstitutionRevision  Int?
  executionConstitutionRevision Int?
  startedAt                     DateTime                @default(now())
  completedAt                   DateTime?
  failureClass                  String?

  @@unique([userId, decisionId])
  @@index([userId, mode, status, startedAt])
}

model DecisionActionEvent {
  id                 String                   @id @default(cuid())
  userId             String
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  decisionId         String
  decision           Decision                 @relation(fields: [userId, decisionId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction)
  actorUserId        String?
  action             DecisionHumanAction
  idempotencyKey     String                   @unique
  reason             String?                  @db.Text
  originalDraft      String?                  @db.Text
  editedDraft        String?                  @db.Text
  resultingState     AutomationExecutionState
  executionAttemptId String?
  createdAt          DateTime                 @default(now())

  @@index([userId, decisionId, createdAt])
}
